{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "编译项目",
      "type": "shell",
      "command": "go",
      "args": [
        "build",
        "-o",
        "${workspaceFolder}\\gatefilter.exe",
        "."
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$go"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "运行项目",
      "type": "shell",
      "command": "${workspaceFolder}\\gatefilter.exe",
      "args": [
        "-c",
        "config.json"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "编译项目",
      "dependsOrder": "sequence",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
